---
import Base from '../layouts/Base.astro';
---

<Base title="הדף לא נמצא | מצוק יעלים" description="הדף שחיפשתם לא נמצא.">
  <main id="main" class="not-found">
    <h1>404</h1>
    <p>הדף שחיפשתם לא נמצא.</p>
    <a class="btn" href="/">חזרה לדף הבית</a>
  </main>
</Base>

<style>
  .not-found {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    text-align: center;

    & h1 {
      font-size: 72px;
      color: var(--accent);
    }
  }
</style>

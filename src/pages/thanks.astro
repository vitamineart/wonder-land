---
// Fallback landing page when a form is submitted without JavaScript.
import Base from '../layouts/Base.astro';
---

<Base title="תודה! | מצוק יעלים" description="קיבלנו את הפרטים שלכם ונחזור אליכם בהקדם.">
  <main id="main" class="thanks">
    <h1>תודה!</h1>
    <p>קיבלנו את הפרטים שלכם ונחזור אליכם בהקדם.</p>
    <a class="btn" href="/">חזרה לדף הבית</a>
  </main>
</Base>

<style>
  .thanks {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: 2rem;
    text-align: center;

    & h1 {
      font-size: 42px;
      color: var(--heading);
    }
  }
</style>

---
import { heroPoster, heroVideoSrc } from '../lib/hero-media';

const poster = await heroPoster();
---

<section id="top" class="hero">
  <div class="hero-text">
    <p class="hero-kicker" data-reveal="fade" style="--delay:.4s">מצפה שלם</p>
    <h1 data-reveal="fade" style="--delay:.5s">לגור באחד מפלאי תבל</h1>
  </div>
  <video
    class="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster={poster.src}
    aria-hidden="true"
  >
    <source src={heroVideoSrc} type="video/mp4" />
  </video>
</section>

<script>
  // Don't autoplay background video for users who prefer reduced motion
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector<HTMLVideoElement>('.hero-video')?.pause();
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    padding: 0;
    overflow: hidden;
    background: var(--dark);

    @media (width >= 992px) {
      aspect-ratio: 100 / 36.25;
    }

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      background-color: rgb(0 0 0 / 0.3);
    }

    &:hover .hero-video {
      filter: sepia(0.7);
    }
  }

  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 1s ease;
  }

  .hero-text {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-inline: var(--gutter);
    color: var(--white);
    text-align: center;

    @media (width >= 576px) {
      width: 70%;
    }
  }

  .hero-kicker {
    margin: 0;
    font-size: 28px;

    @media (width >= 576px) {
      font-size: 36px;
    }
    @media (width >= 992px) {
      font-size: 46px;
    }
  }

  h1 {
    font-size: 32px;
    font-weight: 500;

    @media (width >= 576px) {
      font-size: 42px;
    }
    @media (width >= 992px) {
      font-size: 60px;
    }
  }
</style>

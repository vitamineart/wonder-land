---
import iconUnity from '../assets/icons/icon-unity.svg?url';
import iconMountain from '../assets/icons/icon-mountain.svg?url';
import iconHome from '../assets/icons/icon-home.svg?url';
import iconStudy from '../assets/icons/icon-study.svg?url';

const cards = [
  {
    icon: iconUnity,
    title: 'קהילה שהיא בית',
    text: 'חזון הקיבוץ - להיות קהילה שהיא בית, המעצימה את היחיד, את המשפחה והחברה.',
  },
  {
    icon: iconMountain,
    title: 'המקום היפה בעולם',
    text: 'לחיות במקום שהוכרז כאחד מפלאי תבל מול מי הטורקיז של ים המלח למרגלות מצוק "מעתיק" הנשימה הקדמוני.',
  },
  {
    icon: iconHome,
    title: 'אדריכלות ייחודית',
    text: 'דגם ארמונות החורף מתוכנן כבית אקולוגי המותאם לאזור ולאקלים המקומי, לצד סטנדרט בנייה גבוה.',
  },
  {
    icon: iconStudy,
    title: 'החינוך הטוב ביותר',
    text: 'בתי הספר - היסודי בקיבוץ קלי"ה והתיכון בעין גדי - הם מבתי הספר הטובים ביותר בישראל.',
  },
];
---

<ul class="cards">
  {
    cards.map((c, i) => (
      <li class="card" data-reveal="fade" style={`--delay:${0.1 + i * 0.2}s`}>
        <span class="card-icon">
          <img src={c.icon} alt="" width="70" height="70" loading="lazy" />
        </span>
        <h3 class="card-title">{c.title}</h3>
        <p class="card-text">{c.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .cards {
    display: grid;
    gap: 20px;
    margin: 100px 0 20px;
    padding: 0;
    list-style: none;

    @media (width >= 768px) {
      grid-template-columns: 1fr 1fr;
    }
    @media (width >= 992px) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    padding: 30px 25px;
    text-align: center;
    box-shadow: 0 0 1px 5px hsl(0 0% 70% / 0.1);
    transition: box-shadow 0.3s ease;

    @media (width >= 992px) {
      padding: 50px 25px;
    }

    &:hover {
      box-shadow: 0 0 30px hsl(24 100% 54% / 0.2);
    }
  }

  .card-icon {
    display: inline-block;
    width: 70px;
    height: 70px;
    margin-bottom: 10px;
    border-radius: 50%;
    background-color: var(--accent-soft);

    @media (width >= 992px) {
      margin-bottom: 30px;
    }
  }

  .card-title {
    font-size: 22px;
    font-weight: 500;
    color: var(--heading);
  }

  .card-text {
    margin: 0;
  }
</style>

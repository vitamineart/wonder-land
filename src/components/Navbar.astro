---
import { Image } from 'astro:assets';
import mainLogo from '../assets/images/main-logo.png';
import companyLogo from '../assets/images/company-logo.png';

const links = [
  { href: '#developer', label: 'על היזם' },
  { href: '#kibbutz', label: 'על הקיבוץ' },
  { href: '#homes', label: 'על הבתים' },
  { href: '#contacts', label: 'יצירת קשר' },
  { href: '#project', label: 'על הפרויקט' },
  { href: '#top', label: 'מצפה שלם' },
];
---

<header class="navbar">
  <div class="navbar-inner">
    <a href="/" class="main-logo" aria-label="מצוק יעלים — דף הבית">
      <Image src={mainLogo} alt="" width={77} height={68} densities={[1, 2]} loading="eager" />
    </a>

    <div class="company-logo">
      <Image src={companyLogo} alt="הרי זהב" width={99} height={37} layout="none" loading="eager" />
    </div>

    <button
      id="nav-toggle"
      class="nav-toggle"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="פתיחת תפריט"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="ניווט ראשי">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <div class="nav-backdrop" data-nav-close></div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const nav = document.getElementById('site-nav')!;
  const backdrop = document.querySelector<HTMLElement>('[data-nav-close]')!;
  const mobile = window.matchMedia('(width < 992px)');

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'סגירת תפריט' : 'פתיחת תפריט');
    nav.classList.toggle('open', open);
    backdrop.classList.toggle('open', open);
    document.body.classList.toggle('nav-open', open);
    if (open) nav.querySelector('a')?.focus();
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  backdrop.addEventListener('click', () => setOpen(false));
  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a') && mobile.matches) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('open')) {
      setOpen(false);
      toggle.focus();
    }
  });
  mobile.addEventListener('change', () => setOpen(false));
</script>

<style>
  .navbar {
    position: relative;
    z-index: 100;
    background-color: var(--white);
    padding: 15px;

    @media (width >= 768px) {
      padding: 15px 0;
    }
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: 2%;

    @media (width >= 768px) {
      padding-inline: 5%;
    }
    @media (width >= 1200px) {
      padding-inline: 0;
    }
  }

  .main-logo :global(img) {
    width: 57px;
    height: auto;

    @media (width >= 992px) {
      width: 77px;
    }
  }

  .company-logo {
    order: -1;

    & :global(img) {
      width: 77px;
      height: auto;
    }

    @media (width >= 992px) {
      order: 1;

      & :global(img) {
        width: 99px;
      }
    }
  }

  /* ---------- Desktop nav ---------- */
  .site-nav {
    display: flex;
    align-items: center;
    margin-inline: auto;

    & a {
      position: relative;
      padding: 0 12.5px;
      font-size: 15px;
      font-weight: 500;
      color: #000;
      transition: color 0.3s ease;

      &::after {
        content: '';
        position: absolute;
        bottom: -10px;
        inset-inline: 10%;
        height: 3px;
        background-color: var(--accent);
        opacity: 0;
        transform: translateY(200%);
        transition:
          opacity 0.3s ease,
          transform 0.3s ease;
      }

      &:hover,
      &:focus-visible {
        color: var(--accent);

        &::after {
          opacity: 1;
          transform: none;
        }
      }
    }
  }

  /* ---------- Mobile drawer ---------- */
  @media (width < 992px) {
    .site-nav {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0; /* right edge in RTL */
      width: 73%;
      max-width: 360px;
      flex-direction: column;
      align-items: stretch;
      margin: 0;
      padding-top: 20px;
      background-color: var(--white);
      box-shadow: 0 0 10px hsl(24 28% 55% / 0.44);
      z-index: 110;
      visibility: hidden;
      transform: translateX(105%);
      transition:
        transform 0.3s ease,
        visibility 0.3s;

      &.open {
        visibility: visible;
        transform: none;
      }

      & a {
        display: block;
        padding: 15px 20px;
        border-bottom: 1px solid var(--border);

        &::after {
          display: none;
        }

        &:hover,
        &:focus-visible {
          background-color: var(--accent);
          color: var(--white);
        }
      }
    }
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 105;
    background: rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s;

    &.open {
      opacity: 1;
      visibility: visible;
    }
  }

  /* ---------- Burger ---------- */
  .nav-toggle {
    position: relative;
    z-index: 120;
    width: 36px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;

    @media (width >= 992px) {
      display: none;
    }

    & span {
      position: absolute;
      inset-inline: 0;
      height: 4px;
      border-radius: 9px;
      background: var(--accent);
      transition:
        transform 0.25s ease-in-out,
        opacity 0.25s ease-in-out,
        top 0.25s ease-in-out;

      &:nth-child(1) {
        top: 0;
      }
      &:nth-child(2) {
        top: 14px;
        transform: translateX(-9px);
      }
      &:nth-child(3) {
        top: 28px;
      }
    }

    &[aria-expanded='true'] span {
      &:nth-child(1) {
        top: 14px;
        transform: rotate(135deg);
      }
      &:nth-child(2) {
        opacity: 0;
        transform: translateX(10px);
      }
      &:nth-child(3) {
        top: 14px;
        transform: rotate(-135deg);
      }
    }
  }
</style>
